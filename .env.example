# Copy to .env and fill in. Never commit real values.

# MAX bot token issued by hackathon organizers
BOT_TOKEN=

# Bot username for deep links (optional: taken from the Bot API when empty)
BOT_USERNAME=

# Public HTTPS address of the mini-app (MAX opens mini-apps only over HTTPS)
WEBAPP_URL=https://your-domain.example

# How bot buttons open the mini-app:
#   openapp - the mini-app is bound to the bot, auth by signed initData (OpenAppButton)
#   link    - until the binding is done: a link with a signed token
MINIAPP_MODE=link

# Shift check-in radius around the facility, meters
GEO_RADIUS_M=150

# Host port for docker compose
APP_PORT=8000

# Deploy target for deploy.py (SSH key auth: run `ssh-copy-id root@<host>` once)
DEPLOY_HOST=
DEPLOY_USER=root
